# Public names shown in the control page and overlay.
APP_NAME=Live Radio Bot
BRAND_NAME=Example Radio

# The local server defaults are safe for an OBS machine.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/live-radio-bot.sqlite
SIMULATOR_ENABLED=true
CHANNELS=main
CHANNEL_LABELS=main=Example Radio
DEFAULT_CHANNEL_ID=main

# The bot does not ingest audio. OBS may use any audio source. Now-playing data
# always arrives through POST /api/now-playing and may also come from an optional
# background adapter. Leave this empty unless the bot should poll Radio.co.
NOW_PLAYING_ADAPTER=
NOW_PLAYING_POLL_INTERVAL_MS=10000
RADIOCO_STATIONS=

# Enable these after local simulation works.
YOUTUBE_ENABLED=false
YOUTUBE_CHANNEL_ID=main
# Leave empty to follow the authorized account's active broadcast as video IDs change.
# Set only when the account has multiple simultaneous live broadcasts.
YOUTUBE_BROADCAST_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ENABLE_REPLIES=false

# Optional. Required if HOST exposes the control API beyond localhost.
ADMIN_TOKEN=

# viewer | member | moderator | owner
VOTE_MINIMUM_ROLE=member
